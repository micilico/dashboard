.env

# Local runtimes and generated caches
.venv*/
venv/
**/__pycache__/
**/*.py[cod]
.pytest_cache/
**/.pytest_cache/

# Runtime data may contain API keys, private URLs, media names or paths
*.log
logs/
**/logs/
torrent-panel/data/media-automation-state.json
torrent-panel/data/notification-state.json
torrent-panel/data/stats-state.json
torrent-panel/data/ratio-monitor-state.json
torrent-panel/data/automation-rules.json
torrent-panel/data/tracker-stats-state.json

# Runtime databases and SQLite journals may contain private paths or share tokens
**/*.db
**/*.db-shm
**/*.db-wal
**/*.sqlite
**/*.sqlite3
backups/
