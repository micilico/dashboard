# Cloud Panel listener
CLOUD_PANEL_PORT=3130

# Mount path
CLOUD_PANEL_MOUNT_PATH=/mnt/ultra-media

# Rate limiting
CLOUD_PANEL_RATE_LIMIT_CALLS=40
CLOUD_PANEL_RATE_LIMIT_SECONDS=60
CLOUD_PANEL_READ_RATE_LIMIT_CALLS=120
CLOUD_PANEL_READ_RATE_LIMIT_SECONDS=60
CLOUD_PANEL_LIVE_RATE_LIMIT_CALLS=180
CLOUD_PANEL_LIVE_RATE_LIMIT_SECONDS=60

# Rate limiting on password attempts for public share links
CLOUD_PANEL_SHARE_RATE_LIMIT_CALLS=10
CLOUD_PANEL_SHARE_RATE_LIMIT_SECONDS=300

# CSRF
CLOUD_PANEL_CSRF_TOKEN_TTL_SECONDS=43200

# Token interne serveur→serveur utilisé par le torrent-panel (relink) pour
# renommer des fichiers. Doit correspondre à TORRENT_PANEL_CLOUD_PANEL_INTERNAL_TOKEN.
CLOUD_PANEL_INTERNAL_TOKEN=change-me-shared-secret

# Bounded filesystem caches and recursive-search guard.
CLOUD_PANEL_SCANDIR_CACHE_TTL=0.5
CLOUD_PANEL_SCANDIR_CACHE_MAX_ENTRIES=256
CLOUD_PANEL_EVENTS_INTERVAL_SECONDS=0.5
CLOUD_PANEL_LIVE_SECTION_MAX_IDLE=64
CLOUD_PANEL_FOLDER_SIZE_CACHE_MAX_ENTRIES=128
CLOUD_PANEL_PATH_LOCK_MAX_ENTRIES=256
CLOUD_PANEL_SEARCH_CACHE_TTL=5
CLOUD_PANEL_SEARCH_CACHE_MAX_ENTRIES=64
CLOUD_PANEL_SEARCH_MAX_RESULTS=500
CLOUD_PANEL_SEARCH_MIN_LENGTH=3

# Sentry (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
