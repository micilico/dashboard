# qBittorrent API reached by the Torrent Panel backend only
QBITTORRENT_URL=http://host.docker.internal:16141
QBITTORRENT_USERNAME=change-me
QBITTORRENT_PASSWORD=change-me
QBITTORRENT_TIMEOUT_SECONDS=8
TORRENT_PANEL_TR4KER_ANNOUNCE_URL=https://tr4ker.example/announce?passkey=change-me
TORRENT_PANEL_TRACKER_STATS_STATE_PATH=/app/data/tracker-stats-state.json
TORRENT_PANEL_MEDIA_AUTOMATION_ENABLED=true
TORRENT_PANEL_MEDIA_AUTOMATION_POLL_SECONDS=8
TORRENT_PANEL_MEDIA_AUTOMATION_DEBOUNCE_SECONDS=45
TORRENT_PANEL_MEDIA_AUTOMATION_JELLYFIN_DELAY_SECONDS=5
TORRENT_PANEL_MEDIA_AUTOMATION_MAX_RCLONE_RETRIES=3
TORRENT_PANEL_MEDIA_AUTOMATION_MAX_MOUNT_RETRIES=5
TORRENT_PANEL_MEDIA_AUTOMATION_MAX_JELLYFIN_RETRIES=2
TORRENT_PANEL_MEDIA_MOUNT_PATH=/mnt/ultra-media
# rclone mount refresh: "rc" = vfs/refresh via the local rc API (non-destructive, mount stays up).
# "systemd" = explicit systemctl restart (destructive remount) — opt-in only.
TORRENT_PANEL_RCLONE_REFRESH_MODE=rc
TORRENT_PANEL_RCLONE_RC_REFRESH_URL=http://127.0.0.1:5572/vfs/refresh
TORRENT_PANEL_RCLONE_RC_REFRESH_DIR=
TORRENT_PANEL_RCLONE_RC_TIMEOUT_SECONDS=20
TORRENT_PANEL_RCLONE_SYSTEMD_UNIT=
TORRENT_PANEL_RCLONE_SYSTEMD_RESTART_CMD=
TORRENT_PANEL_JELLYFIN_API_URL=http://host.docker.internal:8096
TORRENT_PANEL_JELLYFIN_API_KEY=change-me
TORRENT_PANEL_JELLYFIN_LIBRARY_MAP=films=<jellyfin-id>,series=<jellyfin-id>,musique=<jellyfin-id>
TORRENT_PANEL_JELLYFIN_GLOBAL_FALLBACK=true

# Quota seedbox ultra.cc — affiche votre quota réel (pas le disque du serveur).
# Installer le script sur le slot : bash <(wget -qO- https://scripts.ultra.cc/util-v2/Ultra-API/main.sh)
# (option 1, puis option 4 pour réafficher le token). Backend uniquement, jamais exposé au frontend.
# URL = base (https://USER.HOST.usbx.me/ultra-api) ou endpoint complet (…/ultra-api/get-diskquota).
# La route réelle du script utilise un tiret (/get-diskquota), repli automatique sur /get_diskquota.
TORRENT_PANEL_ULTRA_API_URL=https://user.host.usbx.me/ultra-api
TORRENT_PANEL_ULTRA_API_TOKEN=change-me

# Sentry monitoring (optional — leave empty to disable)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
